{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.pymol-agent-bridge/bin/pymol-agent-bridge status 2>/dev/null || echo 'pymol-agent-bridge: not configured (run /pymol-setup)'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
